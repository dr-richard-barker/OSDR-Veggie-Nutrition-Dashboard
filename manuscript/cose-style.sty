\ProvidesPackage{cose-style}[2026/08/28 CoSE Custom Style]

% Colors
\RequirePackage{xcolor}
\definecolor{coseblue}{HTML}{3B6EA5}
\definecolor{coseteal}{HTML}{3FB6A8}
\definecolor{cosenavy}{HTML}{2F5985}
\definecolor{cosemint}{HTML}{54C9BA}
\definecolor{cosegold}{HTML}{D4AF37}
\definecolor{cosegray}{HTML}{F8FAFC}
\definecolor{cosedarkgray}{HTML}{0F172A}
\definecolor{cosetext}{HTML}{1E293B}

% Fonts and Typography
\RequirePackage[T1]{fontenc}
\RequirePackage{mathpazo} % Palatino clone
\RequirePackage{helvet}
\RequirePackage{sectsty}
\allsectionsfont{\sffamily\color{cosenavy}}

% Geometry and Layout
\RequirePackage[margin=1in]{geometry}
\RequirePackage{setspace}
\setstretch{1.15}

% Headers and Footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\textbf{OSDR OSD-745:} Veggie Nutritional Analysis}
\fancyhead[R]{\nouppercase{\leftmark}}
\fancyfoot[L]{CoSE Open Science \& Space Biology Initiative \copyright\ 2026}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{cosenavy}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\footrule}{\hbox to\headwidth{\color{cosenavy}\leaders\hrule height \footrulewidth\hfill}}

% Hyperref
\RequirePackage{hyperref}
\hypersetup{
    pdftitle={OSDR Veggie Nutritional Analysis: ML Pipeline & Interactive Dashboard},
    colorlinks=true,
    linkcolor=coseblue,
    filecolor=cosemint,
    urlcolor=coseteal,
    citecolor=coseblue,
}

% Bibliography
\RequirePackage[numbers,sort&compress]{natbib}

% Callout Boxes
\RequirePackage[many]{tcolorbox}
\newtcolorbox{cosealert}[1][]{
    colback=cosegray,
    colframe=cosegold,
    title=\textbf{Alert: #1},
    fonttitle=\sffamily\bfseries,
    coltitle=cosedarkgray,
    arc=4mm,
    boxrule=1.5pt
}
\newtcolorbox{coseagronomy}[1][]{
    colback=cosegray,
    colframe=coseteal,
    title=\textbf{Agronomy Note: #1},
    fonttitle=\sffamily\bfseries,
    arc=2mm,
    boxrule=1.5pt
}
\newtcolorbox{cosemetric}[1][]{
    colback=cosegray,
    colframe=coseblue,
    title=\textbf{Metric: #1},
    fonttitle=\sffamily\bfseries,
    arc=2mm,
    boxrule=1.5pt
}

% Code Listings
\RequirePackage{listings}
\lstdefinestyle{cosestyle}{
    backgroundcolor=\color{cosegray},   
    commentstyle=\color{coseteal},
    keywordstyle=\color{cosenavy},
    numberstyle=\tiny\color{cosedarkgray},
    stringstyle=\color{coseblue},
    basicstyle=\ttfamily\footnotesize\color{cosetext},
    breakatwhitespace=false,         
    breaklines=true,                 
    captionpos=b,                    
    keepspaces=true,                 
    numbers=left,                    
    numbersep=5pt,                  
    showspaces=false,                
    showstringspaces=false,
    showtabs=false,                  
    tabsize=2
}
\lstset{style=cosestyle}

% Graphics
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{booktabs}
\RequirePackage{caption}
\captionsetup{labelfont={color=cosenavy,bf},textfont={color=cosetext}}

\endinput
