{
  "columns": {
    "sample_id": {
      "type": "string",
      "description": "Unique sample identifier combining mission, condition, and plant number",
      "example": "VEG-01A_Flight_P1"
    },
    "mission": {
      "type": "categorical",
      "description": "ISS Veggie mission identifier",
      "values": ["VEG-01A", "VEG-01B", "VEG-03A"],
      "source": "ISA-Tab study factor"
    },
    "condition": {
      "type": "categorical",
      "description": "Experimental treatment: Flight (ISS Veggie) or Ground (KSC chamber control)",
      "values": ["Flight", "Ground"],
      "source": "ISA-Tab study factor"
    },
    "plant_number": {
      "type": "integer",
      "description": "Plant replicate number within a mission and condition (1-6)",
      "range": [1, 6]
    },
    "harvest_day": {
      "type": "integer",
      "description": "Day of growth at which leaves were harvested",
      "unit": "days",
      "range": [33, 56]
    },
    "Fe": {
